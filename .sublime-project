{
    "folders":
    [
        {
            "path": ".",
            "name": "Python Git Repo",
            "folder_exclude_patterns":
            [
                ".git",
                "__pycache__",
                ".pytest_cache",
                ".mypy_cache",
                ".ipynb_checkpoints",
                "build",
                "dist",
                "*.egg-info"
            ],
            "file_exclude_patterns":
            [
                "*.sublime-workspace",
                "*.pyc",
                "*.pyo",
                ".DS_Store"
            ]
        }
    ],
    "settings":
    {
        "tab_size": 4,
        "translate_tabs_to_spaces": true,
        "trim_trailing_white_space_on_save": true,
        "ensure_newline_at_eof_on_save": true,
        "rulers": [88, 100]
    },
    "build_systems":
    [
        {
            "name": "Conda Python",
            "shell_cmd": "conda run -n YOUR_ENV_NAME --no-capture-output python -u \"$file\"",
            "file_regex": "^[ ]*File \"(...*?)\", line ([0-9]*)",
            "selector": "source.python",
            "working_dir": "$file_path",
            "variants":
            [
                {
                    "name": "Run Pytest",
                    "shell_cmd": "conda run -n deproj --no-capture-output pytest",
                    "working_dir": "$folder"
                }
            ]
        }
    ]
}

